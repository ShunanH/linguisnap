{
  "manifest_version": 3,
  "name": "LinguiSnap 划句解构",
  "version": "1.0",
  "description": "像拆解积木一样透视外语骨架",
  "permissions": ["contextMenus", "activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [""],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}